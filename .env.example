# Local development database. Use a libsql:// URL and token for Turso.
TURSO_DATABASE_URL="file:./src/db/local.db"
TURSO_AUTH_TOKEN=""

# Optional Drizzle CLI-only override for a separate migration target.
DRIZZLE_TURSO_DATABASE_URL=""
DRIZZLE_TURSO_AUTH_TOKEN=""

# App/auth origin and Better Auth
APP_BASE_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Better Auth providers
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# MEDIA_BUCKET is a Cloudflare R2 Worker binding, not an environment variable.
# Configure it in wrangler.toml; see docs/cloudflare-workers.md.
