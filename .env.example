# Turso/libSQL Database
# Get your libsql:// URL and auth token from https://turso.tech/dashboard
# Free tier: 1 database, 1GB storage, edge-replicated
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optional: Override for Drizzle CLI (schema generation/migration)
DRIZZLE_TURSO_DATABASE_URL=""
DRIZZLE_TURSO_AUTH_TOKEN=""
# Use a local libSQL file for offline development, or the remote libsql:// URL for Turso.

# Runtime + Drizzle target (Turso/libSQL)
# Use a local libSQL file for offline development, or the remote libsql:// URL for Turso.
TURSO_DATABASE_URL="file:./src/db/local.db"
TURSO_AUTH_TOKEN=""

# Optional Drizzle CLI-only override for schema generation/migration commands.
# Leave unset unless you intentionally want drizzle-kit to hit a different Turso database.
DRIZZLE_TURSO_DATABASE_URL=""
DRIZZLE_TURSO_AUTH_TOKEN=""

# Better Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# Keep BETTER_AUTH_URL aligned with the deployed app origin.
# Comma-separate additional trusted origins only when auth requests can originate elsewhere.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Better Auth Discord Provider
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Better Auth Google Provider
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
